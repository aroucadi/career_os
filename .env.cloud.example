# ==============================================================================
# CareerOS 2.0 - Google Cloud Environment Configuration
# ==============================================================================
# Store sensitive production secrets in Google Cloud Secret Manager.
# Reference them in Cloud Run with: --set-secrets KEY=SECRET_NAME:latest
# ==============================================================================

# Google Gemini LLM Configuration (Behind the scenes reasoning)
GEMINI_API_KEY=your_gemini_api_key_here
DEFAULT_MODEL=gemini-3.7-flash

# CareerOS Core Platform Security
CAREEROS_SECRET_KEY=generate_a_secure_random_64_character_hex_string_here
NODE_ENV=production
PORT=8080

# B2B Recruiter Monetization (Stripe Billing)
STRIPE_SECRET_KEY=your_stripe_secret_key_here
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret_here

# Transactional Candidate Notification Engine (Resend Email)
RESEND_API_KEY=your_resend_api_key_here
NOTIFICATIONS_FROM_EMAIL=notifications@careeros.ai

# Google Cloud Storage (Optional external artifact bucket)
GCS_BUCKET_NAME=careeros-artifacts
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
